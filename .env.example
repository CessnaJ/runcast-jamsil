# Copy to .env.local and enter your test keys. Restart the local server after edits.
# .env.local is ignored by Git. Keep keys here, not in frontend source. ITS alone is handed to the browser on CCTV cache misses.
NAVER_MAP_CLIENT_ID=
KMA_SERVICE_KEY=
KMA_HUB_KEY=
ITS_API_KEY=
# Vercel project > Storage > Neon > Free. Server-only pooled PostgreSQL URL.
DATABASE_URL=
# Optional; normally inferred from VERCEL_ENV (production/preview) or development locally.
# VISIT_STATS_SCOPE=development
